PLATFORM=local                    # local | naka
PORT=2567

# --- โหมด naka (ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย VITE_) ---
NAKA_API_URL=https://naka-lite-api.naka.bot/api
